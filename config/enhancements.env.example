# Public Vite build settings. Never put service, SMS or SMTP secrets in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_OPENING_START_AT=2026-10-01T18:30:00+09:00
VITE_CERTIFICATE_LOGO_URL=/images/logo.png
# Default uses the provided master encoded to public/audio/namo_buddhaya_song.mp3.
# Set cloud to use the existing Supabase object and its signed URL policy.
VITE_NAMO_AUDIO_SOURCE=local
# Optional direct source URL overrides the mode.
VITE_NAMO_AUDIO_URL=

# Supabase Edge server secrets (configure through the deployment secret store).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LMS_ALLOWED_ORIGINS=
LMS_SITE_URL=
LMS_SMS_PROVIDER=mock
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
LMS_SMS_WORKER_SECRET=
LMS_SMS_SENDER=
LMS_SMS_ADMIN_PHONE=01047020283

# Backup runner: daily 03:00 Korea Standard Time, 7-day retention.
BACKUP_DIR=C:/dev/bul/test_artifacts/backups
BACKUP_RETENTION_DAYS=7
BACKUP_EMAIL_TO=tntn211@naver.com
PYTHON_BIN=
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# One-time server-only administrator rotation; never commit the values.
ADMIN_ACCESS_TOKEN=
ADMIN_CANONICAL_ID=
ADMIN_ROTATION_APPROVED_HOST=
ADMIN_BACKUP_MANIFEST_FILE=
NEW_ADMIN_LOGIN=adsba
# Supply NEW_ADMIN_PASSWORD securely at execution or through hidden TTY input.
