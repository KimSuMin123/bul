# Public Vite build settings. Never put service, SMS or SMTP secrets in VITE_*.
# Production Netlify: KimSuMin123/bul, branch feat/minhyeok, npm run build -> dist.
# Only the following Supabase URL/anon variables are configured in Netlify.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_OPENING_START_AT=2026-10-01T18:30:00+09:00
VITE_CERTIFICATE_LOGO_URL=/images/logo.png
# Default uses the provided master encoded to public/audio/namo_buddhaya_song.mp3.
# Set cloud to use the existing Supabase object and its signed URL policy.
VITE_NAMO_AUDIO_SOURCE=local
# Optional direct source URL overrides the mode.
VITE_NAMO_AUDIO_URL=

# Supabase Edge server secrets (configure through the deployment secret store).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LMS_ALLOWED_ORIGINS=
LMS_SITE_URL=
LMS_SMS_PROVIDER=mock
# Production uses solapi; both credentials are stored in Supabase Edge Secrets.
# Example secrets stay blank; do not copy production values here or into VITE_*.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
LMS_SMS_WORKER_SECRET=
# SOLAPI sender 010-8028-7565 is active; real delivery/cron still unverified.
# Change the Edge Function secret only after registering/verifying a replacement sender.
LMS_SMS_SENDER=01080287565
# Administrator recipient is separate from the sending number.
LMS_SMS_ADMIN_PHONE=01080287565
# Only this recipient is authorized for isolated operator tests.
LMS_SMS_TEST_PHONE=01080287565

# Backup runner: daily 03:00 Korea Standard Time, 7-day retention.
BACKUP_DIR=C:/dev/bul/test_artifacts/backups
BACKUP_RETENTION_DAYS=7
BACKUP_EMAIL_TO=tntn211@naver.com
PYTHON_BIN=
# NAVER SMTP: 465 implicit TLS; username is the complete NAVER email address.
# Official help: https://help.naver.com/service/30029/contents/21341?lang=ko&osType=PC
# Username: https://help.naver.com/service/30029/contents/21349?osType=PC
SMTP_HOST=smtp.naver.com
SMTP_PORT=465
SMTP_FROM=tntn211@naver.com
SMTP_USER=tntn211@naver.com
# Enable NAVER SMTP and two-step verification; inject an application password securely.
# This example never contains the account password or application password.
# Production application-password setup awaits the user's new local input form.
SMTP_PASSWORD=

# One-time server-only administrator rotation; never commit the values.
ADMIN_ACCESS_TOKEN=
ADMIN_CANONICAL_ID=
ADMIN_ROTATION_APPROVED_HOST=
ADMIN_BACKUP_MANIFEST_FILE=
NEW_ADMIN_LOGIN=adsba
# Supply NEW_ADMIN_PASSWORD securely at execution or through hidden TTY input.
